# Prefills the self-hosted metadata extractor URL in Profile → Settings on
# first run. Env is only read once at settings-row creation; afterwards the
# value is user-controlled and can be changed/cleared in the app.
# Omit to start empty (falls back to http://<dev-machine-ip>:8000 in dev,
# or to the interim third-party extraction API).
EXPO_PUBLIC_METADATA_EXTRACTOR_URL=http://192.168.1.10:8000